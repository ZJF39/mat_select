# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# ---- Node ----
node_modules/
dist/
dist-ssr/
.vite/
npm-debug.log*

# ---- 数据与运行时产物（数据库本体不入库，种子 JSON 入库） ----
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/backups/
data/exports/

# ---- 日志 ----
*.log

# ---- 临时 / 草稿 / 诊断文件（不入版本控制） ----
*.tmp
*.bak
_tmp/
.tmp/
.gitmessage.txt
.gitmessage.tmp
install_status*.txt
count_idx_tmp.py
# 根目录与 tools/ 下的下划线草稿文件
/_*
/tools/_*

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 工作区内部数据（记忆/技能等，非交付物） ----
.workbuddy/

# ---- 例外：Python 包标记文件必须入库（否则被上面的 _* 规则误伤） ----
!__init__.py
